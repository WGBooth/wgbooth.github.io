source "https://rubygems.org"

# Matches the GitHub Pages build environment: https://pages.github.com/versions/
# It already includes jekyll-remote-theme, jekyll-paginate, jekyll-sitemap,
# jekyll-gist, jekyll-feed, jemoji and jekyll-include-cache at the exact
# versions GitHub uses, so don't list those separately here.
gem "github-pages", "~> 232", group: :jekyll_plugins

gem "webrick" # needed for `jekyll serve` on Ruby 3+
gem "tzinfo-data"
gem "wdm", "~> 0.1.0" if Gem.win_platform?
